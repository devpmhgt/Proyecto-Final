# Conexión a Supabase (PostgreSQL) en formato SQLAlchemy.
# En Supabase: botón Connect > "Transaction pooler" (puerto 6543, compatible con IPv4).
# Use 6543 y no 5432: el modo sesión (5432) admite solo 15 clientes en total y se satura
# cuando varias personas corren el backend contra la misma base.
# Reemplace [PROJECT_REF], [PASSWORD] y [REGION] con los datos de su proyecto.
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Para desarrollo local sin Supabase puede usar SQLite:
# DATABASE_URL=sqlite:///./saiu.db

# JWT: use una clave larga y aleatoria (python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200
